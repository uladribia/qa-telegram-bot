# Copy to .env and fill in real values. Never commit .env.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_ID=
TELEGRAM_BOT_USERNAME=
ALLOWED_TELEGRAM_CHAT_ID=
# Who may open a private chat with the bot. Comma-separated user ids. The admin
# (ADMIN_TELEGRAM_USER_ID) is always allowed. A public bot username is
# discoverable, so leaving this empty means only the admin can DM it; anyone
# else is ignored. Group members who should be able to propose corrections
# belong here.
ALLOWED_TELEGRAM_USER_IDS=
ADMIN_TELEGRAM_USER_ID=

# Internal endpoints (X-Internal-Key)
INTERNAL_ADMIN_KEY=

# Models (must be in ALLOWED_AI_MODELS)
EMBEDDING_MODEL=@cf/google/embeddinggemma-300m
GENERATION_MODEL=@cf/zai-org/glm-4.7-flash

# Tunable thresholds (provisional; calibrate with evals)
QUESTION_THRESHOLD=
DIRECT_QA_THRESHOLD=0.7
SYNTHESIS_THRESHOLD=0.3
QA_TOP_K=5
MESSAGE_TOP_K=8
CONFLICT_MARGIN=

# Periodic recap
RECAP_ENABLED=true
RECAP_INTERVAL_HOURS=24
RECAP_LANGUAGE=ca

# Ingest all group traffic for knowledge building; off means only addressed
# messages are stored and answered.
BACKGROUND_LISTENER_ENABLED=false

# Workers AI quota guard. The free plan allows 10k neurons/day; when it runs out
# the bot can answer nothing until 00:00 UTC. Spend is estimated from characters
# (Cloudflare does not expose real usage to a Worker), so these are deliberately
# conservative. The reserve is held back for real user traffic: only evals and
# reindex are refused once (budget - reserve) is reached.
AI_DAILY_NEURON_BUDGET=10000
AI_NEURON_RESERVE_FRACTION=0.25
AI_EMBED_NEURONS_PER_CHAR=0.015
AI_CHAT_NEURONS_PER_CHAR=0.020
