# Copy to .env and fill in real values. Never commit .env.
KB_RUNTIME=cloudflare

# Telegram connector
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_ID=
TELEGRAM_BOT_USERNAME=
ALLOWED_TELEGRAM_USER_IDS=
ADMIN_TELEGRAM_USER_ID=
REVIEWER_ESCALATION_TIMEOUT_SECONDS=86400

# Internal operations
INTERNAL_ADMIN_KEY=

# Zero-cost Workers AI models
EMBEDDING_MODEL=@cf/google/embeddinggemma-300m
# Non-reasoning grounded generation. The previous reasoning model
# (@cf/zai-org/glm-4.7-flash) spent 10k characters of deliberation and 53s on a
# single question; this one answers the same question in 2.5s and correctly
# abstains when the evidence does not support an answer.
GENERATION_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct
# Cross-encoder that reorders the fused candidate pool. One call scores the
# whole list: ~0.5s, ~0.3 neurons, one subrequest.
RERANKER_MODEL=@cf/baai/bge-reranker-base
AI_EMBED_TIMEOUT_SECONDS=10
AI_GENERATION_TIMEOUT_SECONDS=35
# Output budget per generation call. The generation model is a reasoning model:
# uncapped, it deliberated past 2600 tokens and 53 s on evidence that did not
# contain the answer. 1024 keeps real answers and turns the rest into a fast
# abstention.
AI_GENERATION_MAX_TOKENS=1024

# Retrieval and listener settings
BACKGROUND_LISTENER_ENABLED=true
# Answer selection: the only knob. Q&A above this floor are sent to the
# generator; a question with nothing above it abstains. Tuned locally and
# adjustable in production without a code change.
ANSWER_SIMILARITY_FLOOR=0.45
QA_TOP_K=5
MESSAGE_TOP_K=4
PAIRING_QUESTION_WINDOW_MINUTES=5
PAIRING_MAX_PENDING_QUESTIONS=5
CLASSIFIER_CONFIDENCE=0.60
CLASSIFIER_MARGIN=0.15
CLASSIFIER_MODEL_PATH=data/classifier/model.json

# Quota estimates
AI_DAILY_NEURON_BUDGET=10000
AI_NEURON_RESERVE_FRACTION=0.25
AI_BACKGROUND_BUDGET_FRACTION=0.50
AI_MAINTENANCE_BUDGET_FRACTION=0.70
AI_EMBED_NEURONS_PER_CHAR=0.015
AI_CHAT_NEURONS_PER_CHAR=0.020
