# Copy to .env and fill in real values. Never commit .env.
KB_RUNTIME=cloudflare

# Telegram connector
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_ID=
TELEGRAM_BOT_USERNAME=
ALLOWED_TELEGRAM_USER_IDS=
ADMIN_TELEGRAM_USER_ID=
# How the bot behaves in a private chat: off | silent | active | proactive.
# A private message always addresses the bot, so proactive is the same as
# active here. Groups have their own mode, set per group with
# `kb group add --mode`, and it is not affected by this value.
TELEGRAM_DM_BOT_MODE=active
REVIEWER_ESCALATION_TIMEOUT_SECONDS=86400

# Internal operations
INTERNAL_ADMIN_KEY=

# Record message text, sender identity, prompts, and answers on the process
# log, so a flow can be reconstructed while debugging. Credentials are always
# scrubbed and are never recorded.
KB_CAPTURE_CONTENT=true

# Zero-cost Workers AI models
EMBEDDING_MODEL=@cf/google/embeddinggemma-300m
# Grounded generation. glm-4.7-flash reasons by default and its deliberation
# does not fit AI_GENERATION_TIMEOUT_SECONDS: left thinking it spent 53s and
# 101 neurons on one question and the user saw "no info available". Always pair
# it with AI_DISABLE_THINKING=true, which measured 3.3-3.9s per call.
GENERATION_MODEL=@cf/zai-org/glm-4.7-flash
# Required for glm-4.7-flash. Sent as chat_template_kwargs.enable_thinking.
# Without it the model overruns the generation deadline and answers nothing.
AI_DISABLE_THINKING=true
AI_EMBED_TIMEOUT_SECONDS=10
AI_GENERATION_TIMEOUT_SECONDS=35
# Output budget per generation call. The model is a reasoning model if you
# configure one: uncapped, glm-4.7-flash deliberated past 2600 tokens and 53 s
# on evidence that did not contain the answer. 1024 keeps real answers and
# turns the rest into a fast abstention.
AI_GENERATION_MAX_TOKENS=1024

# Retrieval and listener settings
# There is no listener switch: a served group stores what is said in it unless
# its mode is `off`, and its mode is per group (see `kb group add --mode`).
# Answer selection: the only knob. Q&A above this floor are sent to the
# generator; a question with nothing above it abstains. Calibrated in
# production on the 43 answerable eval questions: 0.35 is the lowest top-1
# cosine any of them has, so this floor is what gives every answerable
# question its full evidence set. It is not a precision device -- most
# unanswerable questions clear it too, and the model is what declines them.
ANSWER_SIMILARITY_FLOOR=0.35
# Q&A candidates handed to the generator. Width 5 is what ships; it is the
# width the gated retrieval metric describes. Raising it widens the prompt
# and the token cost, so measure before raising it again.
QA_TOP_K=5
MESSAGE_TOP_K=2
# Lexical (BM25) leg over Q&A ANSWER text. 0 = disabled, which is what ships:
# it measured 23/26 on the live gold set against 24/26 without it. The code and
# the FTS projection are kept so the leg can be revived behind a generator fix.
# When enabled it runs only if the semantic pool already cleared
# ANSWER_SIMILARITY_FLOOR, so it can add context but never authorise an answer
# alone. BM25 scores are unbounded and not comparable with cosine, so this leg
# has a width and a strength floor instead of a similarity floor. Costs no AI
# budget to query.
QA_ANSWER_TOP_K=0
# Below this BM25 strength nothing discriminative matched: SQLite's bm25 zeroes
# a term as its document frequency rises, so a near-zero total means the query
# matched only ubiquitous words.
QA_ANSWER_MIN_STRENGTH=0.5
# Keep hits within this fraction of the query's own best hit.
QA_ANSWER_RELATIVE_CUT=0.5
# Authority given to a lexical hit. Provenance stays official: the text is the
# club's own curated answer, only the match is unverified.
LEXICAL_AUTHORITY=45
PAIRING_QUESTION_WINDOW_MINUTES=5
PAIRING_MAX_PENDING_QUESTIONS=5
CLASSIFIER_CONFIDENCE=0.60
CLASSIFIER_MARGIN=0.15
CLASSIFIER_MODEL_PATH=data/classifier/model.json

# Listener and answer decisions. `systemone` is the shipped path: one decision
# call per listener message and one per answered question. `baseline` is the
# linear classifier, the cosine floor and prompt-only abstention, needs no
# decision service, and is the rollback.
DECISION_BACKEND=systemone
# Read by the local runtime only; the Worker uses its AI binding.
DECISION_BASE_URL=http://knowledge-bot-ollama:11434
DECISION_MODEL=@cf/cloudflare/clef-flash
AI_DECISION_TIMEOUT_SECONDS=8
# Ask the decision service which open questions the message answers, or leave
# that to the deterministic pairing policy. Off: pairing stays deterministic.
DECISION_INCLUDE_RELEVANCE=false
# After retrieval, ask whether the shortlist is enough and which items answer.
# Retrieval still chooses the shortlist and the cosine floor still bounds it.
DECISION_ANSWER_PATH=true
DECISION_SUFFICIENCY_THRESHOLD=0.50
DECISION_SELECTION_THRESHOLD=0.90
# Answer from the baseline decision when the service is unreachable or answers
# something unusable, so an outage degrades the listener instead of losing the
# message. Every fallback is logged as `decision_fallback_to_baseline`.
DECISION_FALLBACK_TO_BASELINE=true
# A relevance decision pairs a message only above the threshold, and only when
# the runner-up is at least this far below the winner.
RETROEVAL_RELEVANCE_THRESHOLD=0.80
RETROEVAL_RELEVANCE_MARGIN=0.15

# Quota estimates
AI_DAILY_NEURON_BUDGET=10000
AI_NEURON_RESERVE_FRACTION=0.25
AI_BACKGROUND_BUDGET_FRACTION=0.50
AI_MAINTENANCE_BUDGET_FRACTION=0.70
# Ceiling for uninvited answers in a proactive group, as a fraction of the
# daily budget. It sits below the background ceiling on purpose: answering
# nobody asked for is the first thing to stop, never at the cost of the
# classification and indexing that make tomorrow's answers possible.
AI_PROACTIVE_BUDGET_FRACTION=0.35
AI_EMBED_NEURONS_PER_CHAR=0.015
AI_CHAT_NEURONS_PER_CHAR=0.020
