# Copy to .env and fill in real values. Never commit .env.
KB_RUNTIME=cloudflare

# Telegram connector
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_ID=
TELEGRAM_BOT_USERNAME=
ALLOWED_TELEGRAM_USER_IDS=
ADMIN_TELEGRAM_USER_ID=
REVIEWER_ESCALATION_TIMEOUT_SECONDS=86400

# Internal operations
INTERNAL_ADMIN_KEY=

# Observability (Logfire, EU region, project oleguer-sagarra/qa-telegram).
# Optional. Without a token the app runs normally and spans stay local.
LOGFIRE_TOKEN=
KB_LOGFIRE_SEND_TO_LOGFIRE=true
# Export message text, sender identity, prompts, and answers. On while
# testing so a flow can be reconstructed; credentials stay scrubbed either way.
KB_LOGFIRE_CAPTURE_CONTENT=true

# Zero-cost Workers AI models
EMBEDDING_MODEL=@cf/google/embeddinggemma-300m
# Grounded generation. glm-4.7-flash reasons by default and its deliberation
# does not fit AI_GENERATION_TIMEOUT_SECONDS: left thinking it spent 53s and
# 101 neurons on one question and the user saw "no info available". Always pair
# it with AI_DISABLE_THINKING=true, which measured 3.3-3.9s per call.
GENERATION_MODEL=@cf/zai-org/glm-4.7-flash
# Required for glm-4.7-flash. Sent as chat_template_kwargs.enable_thinking.
# Without it the model overruns the generation deadline and answers nothing.
AI_DISABLE_THINKING=true
AI_EMBED_TIMEOUT_SECONDS=10
AI_GENERATION_TIMEOUT_SECONDS=35
# Output budget per generation call. The model is a reasoning model if you
# configure one: uncapped, glm-4.7-flash deliberated past 2600 tokens and 53 s
# on evidence that did not contain the answer. 1024 keeps real answers and
# turns the rest into a fast abstention.
AI_GENERATION_MAX_TOKENS=1024

# Retrieval and listener settings
BACKGROUND_LISTENER_ENABLED=true
# Answer selection: the only knob. Q&A above this floor are sent to the
# generator; a question with nothing above it abstains. Calibrated in
# production on the 43 answerable eval questions: 0.35 is the lowest top-1
# cosine any of them has, so this floor is what gives every answerable
# question its full evidence set. It is not a precision device -- most
# unanswerable questions clear it too, and the model is what declines them.
ANSWER_SIMILARITY_FLOOR=0.35
# Q&A candidates handed to the generator. Width 5 is what ships; it is the
# width the gated retrieval metric describes. Raising it widens the prompt
# and the token cost, so measure before raising it again.
QA_TOP_K=5
MESSAGE_TOP_K=2
PAIRING_QUESTION_WINDOW_MINUTES=5
PAIRING_MAX_PENDING_QUESTIONS=5
CLASSIFIER_CONFIDENCE=0.60
CLASSIFIER_MARGIN=0.15
CLASSIFIER_MODEL_PATH=data/classifier/model.json

# Quota estimates
AI_DAILY_NEURON_BUDGET=10000
AI_NEURON_RESERVE_FRACTION=0.25
AI_BACKGROUND_BUDGET_FRACTION=0.50
AI_MAINTENANCE_BUDGET_FRACTION=0.70
AI_EMBED_NEURONS_PER_CHAR=0.015
AI_CHAT_NEURONS_PER_CHAR=0.020
