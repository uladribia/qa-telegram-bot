# Secrets / local config
.env
.env.*
!.env.example
!.env.local.example
.dev.vars

# Real Telegram E2E (Telethon session and settings are credential material)
.e2e/
.env.e2e
!.env.e2e.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.venv-workers/
venv/

# Tool caches
.ruff_cache/
.ty/
.mypy_cache/
.pytest_cache/
# Local eval embedding cache; derived state, safe to delete.
.cache/
.coverage
.coverage.*
htmlcov/

# Cloudflare / wrangler
.wrangler/
node_modules/
python_modules/
pylock.toml
*.sqlite
*.sqlite3

# Raw exports are generated locally and never committed. The knowledge base
# itself is versioned: the bot's self-explanation Q&A and the website Q&A seed
# are the only reproducible record of what was ever seeded, so losing them makes
# the knowledge base unrebuildable from the repo. The WhatsApp imports stay
# ignored: they are large parsed copies of data/raw/*, and the knowledge they
# produced is already in the seed and in D1.
data/raw/*
!data/raw/.gitkeep
data/seed/*
!data/seed/bot_self_qa.json
!data/seed/qa.json

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp
*.swo
*.sw?  # vim/editor swap files (may contain secrets)
