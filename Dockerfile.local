# SPDX-License-Identifier: MIT
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/workspace/.venv

COPY --from=ghcr.io/astral-sh/uv:0.12.17 /uv /uvx /bin/

WORKDIR /workspace

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-default-groups --group dev --group local --no-install-project

COPY . .
RUN uv sync --frozen --no-default-groups --group dev --group local

EXPOSE 8000

CMD [".venv/bin/uvicorn", "local_entry:app", "--host", "0.0.0.0", "--port", "8000"]
