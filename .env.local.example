KB_RUNTIME=local
KB_SQLITE_PATH=/data/knowledge-bot.sqlite3
OLLAMA_BASE_URL=http://knowledge-bot-ollama:11434
EMBEDDING_MODEL=embeddinggemma
GENERATION_MODEL=gemma3:270m
TELEGRAM_DM_BOT_MODE=active
# Listener decisions. The local runtime takes them from the local System-One
# service (Ollama serving tev1:0.8b) so the local stack exercises the same
# request path production uses. Production stays on the baseline backend and
# gains no remote decision adapter. Candidate relevance stays with the
# deterministic pairing policy, and a service outage degrades to the linear
# classifier instead of losing the message. See docs/operations.md.
DECISION_BACKEND=systemone
DECISION_BASE_URL=http://knowledge-bot-ollama:11434
DECISION_MODEL=tev1:0.8b
DECISION_INCLUDE_RELEVANCE=false
DECISION_FALLBACK_TO_BASELINE=true
AI_DECISION_TIMEOUT_SECONDS=20
REVIEWER_ESCALATION_TIMEOUT_SECONDS=86400
# Align the local pipeline with production. The floor is calibrated in
# production, not locally; QA_TOP_K and MESSAGE_TOP_K are the deployed widths.
ANSWER_SIMILARITY_FLOOR=0.35
QA_TOP_K=5
MESSAGE_TOP_K=2
QA_ANSWER_TOP_K=0
QA_ANSWER_MIN_STRENGTH=0.5
QA_ANSWER_RELATIVE_CUT=0.5
LEXICAL_AUTHORITY=45
# Logfire (EU region, project oleguer-sagarra/qa-telegram). Optional: without
# a token the app runs normally and spans stay local. Inside the container
# there is no .logfire directory, so the token must come from here.
LOGFIRE_TOKEN=
KB_LOGFIRE_SEND_TO_LOGFIRE=true
# Export message text, sender identity, prompts, and answers while debugging.
KB_LOGFIRE_CAPTURE_CONTENT=true
INTERNAL_ADMIN_KEY=local-development-key
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_ID=
TELEGRAM_BOT_USERNAME=
ADMIN_TELEGRAM_USER_ID=
AI_EMBED_TIMEOUT_SECONDS=10
AI_GENERATION_TIMEOUT_SECONDS=35
