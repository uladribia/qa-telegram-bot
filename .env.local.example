KB_RUNTIME=local
KB_SQLITE_PATH=/data/knowledge-bot.sqlite3
OLLAMA_BASE_URL=http://knowledge-bot-ollama:11434
EMBEDDING_MODEL=embeddinggemma
GENERATION_MODEL=gemma3:270m
TELEGRAM_DM_BOT_MODE=active
# Listener and answer decisions, mirroring production. The production decision
# model is @cf/cloudflare/clef-flash over Workers AI; locally the same code
# path and the same request shape run against a model Ollama serves on
# /v1/systemone. The local model is a stand-in, not the shipped one: measure
# behaviour locally, never quality.
DECISION_BACKEND=systemone
DECISION_BASE_URL=http://knowledge-bot-ollama:11434
DECISION_MODEL=tev1:0.8b
AI_DECISION_TIMEOUT_SECONDS=8
# Pairing relevance stays with the deterministic policy; the decision model
# classifies and, after retrieval, judges sufficiency and evidence selection.
DECISION_INCLUDE_RELEVANCE=false
DECISION_ANSWER_PATH=true
DECISION_FALLBACK_TO_BASELINE=true
DECISION_SUFFICIENCY_THRESHOLD=0.50
DECISION_SELECTION_THRESHOLD=0.90
REVIEWER_ESCALATION_TIMEOUT_SECONDS=86400
# Align the local pipeline with production. The floor is calibrated in
# production, not locally; QA_TOP_K and MESSAGE_TOP_K are the deployed widths.
ANSWER_SIMILARITY_FLOOR=0.35
QA_TOP_K=5
MESSAGE_TOP_K=2
QA_ANSWER_TOP_K=0
QA_ANSWER_MIN_STRENGTH=0.5
QA_ANSWER_RELATIVE_CUT=0.5
LEXICAL_AUTHORITY=45
# Record message text, sender identity, prompts, and answers on the process
# log while debugging. Credentials are always scrubbed.
KB_CAPTURE_CONTENT=true
INTERNAL_ADMIN_KEY=local-development-key
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_ID=
TELEGRAM_BOT_USERNAME=
ADMIN_TELEGRAM_USER_ID=
AI_EMBED_TIMEOUT_SECONDS=10
AI_GENERATION_TIMEOUT_SECONDS=35
