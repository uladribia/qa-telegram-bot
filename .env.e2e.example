# Real Telegram E2E harness settings (e2e/telegram/config.py). Never commit
# the real .env.e2e: it carries the internal admin key and your Telethon
# session references.

# Set to 1 to authorize the live run (same flag as the other live tests).
ALLOW_CLOUDFLARE_LIVE_TESTS=0

# Deployed Worker to test against (must be HTTPS).
BOT_BASE_URL=

# The deployed Worker's internal admin key (fixture setup/cleanup only).
INTERNAL_ADMIN_KEY=

# Telegram app credentials of the EXISTING HUMAN admin account
# (create or look up at my.telegram.org -> API development tools).
TELEGRAM_E2E_API_ID=
TELEGRAM_E2E_API_HASH=

# The bot's @username, without the @.
TELEGRAM_E2E_BOT_USERNAME=

# Exact titles of the two dedicated E2E groups (both contain you and the bot).
TELEGRAM_E2E_GROUP_A_TITLE=[E2E] QA A
TELEGRAM_E2E_GROUP_B_TITLE=[E2E] QA B

# Where the Telethon session file lives (credential material, gitignored).
TELEGRAM_E2E_SESSION_PATH=.e2e/telegram-user

# Default timeout for waiting on bot messages.
TELEGRAM_E2E_TIMEOUT_SECONDS=75
